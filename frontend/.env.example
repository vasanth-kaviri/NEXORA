# ==========================================
# NEXORA PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Firebase Authentication & Realtime Database
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 2. Google Gemini 2.0 AI Mentor (Google AI Studio)
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Adzuna Global Job Search API (Free: 250 requests/month)
# https://developer.adzuna.com/
VITE_ADZUNA_APP_ID=your_adzuna_app_id
VITE_ADZUNA_APP_KEY=your_adzuna_app_key

# 4. GitHub API (Optional: extends rate limits for trending repositories)
VITE_GITHUB_TOKEN=

# 5. Admin Passkey (Defaults to admin2026 if empty)
VITE_ADMIN_PASSKEY=admin2026
